# Server Configuration
PORT=5443
HTTP_PORT=5081
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/hustlehub

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_ISSUER=hustlehub-plus
JWT_AUDIENCE=hustlehub-api

# SSL Configuration
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5443

# MongoDB
MONGODB_URI_ATLAS=
MONGODB_URI_LOCAL=mongodb://localhost:27017/hustlehub

# ==========================================
# Logging (Grafana Cloud)
# ==========================================
LOG_LEVEL=info

GRAFANA_OTLP_ENDPOINT=
GRAFANA_USER_ID=
GRAFANA_API_TOKEN=